# Local development only. Do not put real secrets in this file or commit it.
FLASK_ENV=development
AUTO_CREATE_DB=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///managerws_gt.db

# Production backend requirements (enter real values in Railway Variables only)
# FLASK_ENV=production
# AUTO_CREATE_DB=false
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# SECRET_KEY=<unique-long-random-secret>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# REDIS_URL=redis://...
# PUBLIC_BASE_URL=https://your-managerws-domain
# ADMIN_USERNAME=                         # temporary bootstrap only, if needed
# ADMIN_EMAIL=
# ADMIN_PASSWORD=                         # remove after confirming bootstrap

# PayPal LIVE subscriptions. Keep disabled until plans, webhook, DB and UI are verified.
# The PayPal Subscriptions API does not list GTQ, HNL, NIO or CRC as supported currencies.
# This release defaults PayPal subscriptions to USD; the actual PayPal price is shown separately.
# PAYPAL_MODE=live
# PAYPAL_ENABLED=false                    # change to true only for controlled live verification
# PAYPAL_CURRENCY=USD
# PAYPAL_CLIENT_ID=                       # copy from PayPal Live app to Railway, not the ZIP
# PAYPAL_CLIENT_SECRET=                   # secret: Railway Variables only, never Git/chat
# PAYPAL_WEBHOOK_ID=                      # ID returned after creating the live webhook
# PAYPAL_PLAN_PRO_USD=                    # active monthly PayPal Billing Plan ID
# PAYPAL_PLAN_BUSINESS_USD=
# PAYPAL_PLAN_ENTERPRISE_USD=
# PAYPAL_PRICE_PRO_USD=                    # expected recurring price matching the PayPal plan
# PAYPAL_PRICE_BUSINESS_USD=
# PAYPAL_PRICE_ENTERPRISE_USD=
# BILLING_GRACE_DAYS=3

# Recurrente is not wired into the Flask billing UI in this release.
# Do not enable the legacy Supabase Edge Function billing path for this backend.
